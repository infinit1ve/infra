# yaml-language-server: $schema=https://raw.githubusercontent.com/bjw-s-labs/helm-charts/main/charts/library/common/values.schema.json

controllers:
  main:
    strategy: Recreate
    containers:
      main:
        image:
          repository: ghcr.io/dani-garcia/vaultwarden
          tag: 1.37.5
          digest: sha256:4fe17f415f90087377d37c755e0ea3cf189dcc6794e49cdd2a9adbb4937d9e1f
        env:
          DATA_FOLDER: "config"
          DATABASE_URL:
            valueFrom:
              secretKeyRef:
                name: vaultwarden-db-app
                key: uri
          PUSH_ENABLED: true
          PUSH_INSTALLATION_ID: {{ .Values.services.k3s.vaultwarden.instance.id | quote }}
          PUSH_INSTALLATION_KEY: {{ .Values.services.k3s.vaultwarden.instance.key | quote }}
          PUSH_RELAY_URI: https://api.bitwarden.eu
          PUSH_IDENTITY_URI: https://identity.bitwarden.eu
          DOMAIN: "https://vaultwarden.{{ .Values.domain }}"
          SENDS_ALLOWED: false
          SIGNUPS_VERIFY: true
          SMTP_HOST: {{ .Values.services.email.host | quote }}
          SMTP_FROM: "vaultwarden@{{ .Values.services.email.domain }}"
          SMTP_USERNAME: {{ .Values.services.email.user | quote }}
          SMTP_PASSWORD: {{ .Values.services.email.password | quote }}
          SMTP_PORT: {{ .Values.services.email.port | quote }}
          SMTP_SECURITY: force_tls
        probes:
          liveness:
            enabled: true
            custom: true
            spec:
              httpGet:
                path: /
                port: 80
              initialDelaySeconds: 30
              periodSeconds: 15
          readiness:
            enabled: true
            custom: true
            spec:
              httpGet:
                path: /alive
                port: 80
              initialDelaySeconds: 30
              periodSeconds: 15
      bitwarden-portal:
        image:
          repository: ghcr.io/baragoon/bitwarden-portal
          tag: v1.1.1
          digest: sha256:11a39f2bd8bc5ffd1cc2da74b9691ee7099612e640bb4afea16fa1b622c1a6ab
        dependsOn: "main"
        env:
          TZ: Europe/Berlin
          CRON_SCHEDULE: 0 0 * * *
          ENCRYPTION_PASSWORD:
            valueFrom:
              secretKeyRef:
                name: bw-portal-secret
                key: encryption_password
          SOURCE_ACCOUNT:
            valueFrom:
              secretKeyRef:
                name: bw-portal-secret
                key: source_account
          SOURCE_PASSWORD:
            valueFrom:
              secretKeyRef:
                name: bw-portal-secret
                key: source_password
          SOURCE_CLIENT_ID:
            valueFrom:
              secretKeyRef:
                name: bw-portal-secret
                key: source_id
          SOURCE_CLIENT_SECRET:
            valueFrom:
              secretKeyRef:
                name: bw-portal-secret
                key: source_secret
          SOURCE_SERVER: https://vault.bitwarden.eu
          DEST_ACCOUNT:
            valueFrom:
              secretKeyRef:
                name: bw-portal-secret
                key: dest_account
          DEST_PASSWORD:
            valueFrom:
              secretKeyRef:
                name: bw-portal-secret
                key: dest_password
          DEST_CLIENT_ID:
            valueFrom:
              secretKeyRef:
                name: bw-portal-secret
                key: dest_id
          DEST_CLIENT_SECRET:
            valueFrom:
              secretKeyRef:
                name: bw-portal-secret
                key: dest_secret
          DEST_SERVER: "https://vaultwarden.{{ .Values.domain }}"
          ENABLE_PRUNING: true
          RETENTION_DAYS: 30
          MIN_FILES: 15

service:
  main:
    controller: main
    ports:
      http:
        port: 80
      websocket:
        enabled: true
        port: 3012

ingress:
  main:
    hosts:
      - host: vaultwarden.{{ .Values.domain }}
        paths:
          - path: /
            pathType: Prefix
            service:
              identifier: main
              port: http

persistence:
  config:
    type: persistentVolumeClaim
    storageClass: longhorn
    accessMode: ReadWriteOnce
    size: 2Gi
    advancedMounts:
      main:
        main:
          - path: /data
        bitwarden-portal:
          - path: /shared
            subPath: vaultwarden-backups
