resources:
- apiVersion: traefik.io/v1alpha1
  kind: IngressRoute
  metadata:
    name: immich-ingress
  spec:
    routes:
      - match: Host(`immich.{{ .Values.domain }}`)
        kind: Rule
        services:
          - name: immich
            port: 5004

- apiVersion: v1
  kind: Service
  metadata:
    name: immich
  spec:
    ports:
      - name: http
        protocol: TCP
        port: 5004
        targetPort: 5004

- apiVersion: discovery.k8s.io/v1
  kind: EndpointSlice
  metadata:
    name: immich-1 # by convention, use the name of the Service
                     # as a prefix for the name of the EndpointSlice
    labels:
    # You should set the "kubernetes.io/service-name" label.
    # Set its value to match the name of the Service
      kubernetes.io/service-name: immich
  addressType: IPv4
  ports:
    - name: http # should match with the name of the service port defined above
      appProtocol: http
      protocol: TCP
      port: 5004
  endpoints:
    - addresses:
      - "10.12.3.3"
