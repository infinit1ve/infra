# yaml-language-server: $schema=https://raw.githubusercontent.com/bjw-s-labs/helm-charts/main/charts/library/common/values.schema.json

controllers:
  main:
    strategy: Recreate
    containers:
      main:
        image:
          repository: ghcr.io/paperless-ngx/paperless-ngx
          tag: 3.5.1
          digest: sha256:8508853b8a0f8394074260957d0be186c8c64f346973b24a7583de4580f306b9
        dependsOn:
          - "tika"
          - "gotenberg"
          - "redis"
        env:
          PAPERLESS_REDIS: redis://localhost:6379
          PAPERLESS_DBENGINE: postgresql
          PAPERLESS_DBHOST:
            valueFrom:
              secretKeyRef:
                name: paperless-db-app
                key: host
          PAPERLESS_DBPORT:
            valueFrom:
              secretKeyRef:
                name: paperless-db-app
                key: port
          PAPERLESS_DBNAME:
            valueFrom:
              secretKeyRef:
                name: paperless-db-app
                key: dbname
          PAPERLESS_DBUSER:
            valueFrom:
              secretKeyRef:
                name: paperless-db-app
                key: username
          PAPERLESS_DBPASS:
            valueFrom:
              secretKeyRef:
                name: paperless-db-app
                key: password
          PAPERLESS_SECRET_KEY: {{ .Values.services.k3s.paperless | quote }}
          PAPERLESS_TIME_ZONE: Europe/Berlin
          PAPERLESS_OCR_LANGUAGES: eng deu ukr
          PAPERLESS_URL: "https://paperless.{{ .Values.domain }}"
          PAPERLESS_TIKA_ENABLED: 1
          PAPERLESS_TIKA_GOTENBERG_ENDPOINT: http://localhost:3000
          PAPERLESS_TIKA_ENDPOINT: http://localhost:9998
          PAPERLESS_DATA_DIR: /pdata
          PAPERLESS_MEDIA_ROOT: /media
        probes:
          liveness:
            enabled: true
            custom: true
            spec:
              httpGet:
                path: /accounts/login/
                port: 8000
                httpHeaders:
                  - name: Host
                    value: localhost
              initialDelaySeconds: 30
              periodSeconds: 15
          readiness:
            enabled: true
            custom: true
            spec:
              httpGet:
                path: /accounts/login/
                port: 8000
                httpHeaders:
                  - name: Host
                    value: localhost
              initialDelaySeconds: 15
              periodSeconds: 10
          startup:
            enabled: true
            custom: true
            spec:
              httpGet:
                path: /accounts/login/
                port: 8000
                httpHeaders:
                  - name: Host
                    value: localhost
              failureThreshold: 30
              periodSeconds: 10
      redis:
        image:
          repository: docker.io/valkey/valkey
          tag: 9-alpine
          digest: sha256:3ad5a213cb1bc2fd4a113c89b6248a88655a6bf1dda69519d04e03cd3e3d2742
      gotenberg:
        image:
          repository: docker.io/gotenberg/gotenberg
          tag: 8.40
          digest: sha256:53073e798c8ef39ea2187e44cb67bab77894ea2509100b94c4fe3b461f7b2996
        command:
          - "gotenberg"
        args:
          - "--chromium-disable-javascript=true"
          - "--chromium-allow-list=^file:///tmp/.*"
      tika:
        image:
          repository: docker.io/apache/tika
          tag: 3.4.0.0
          digest: sha256:9f3e5bb9da4229a971a4839416b3204499f20668ee834fa741a6a7504bbea7bf

service:
  main:
    controller: main
    ports:
      http:
        port: 80
        targetPort: 8000

ingress:
  main:
    hosts:
      - host: paperless.{{ .Values.domain }}
        paths:
          - path: /
            pathType: Prefix
            service:
              identifier: main
              port: http

persistence:
  ephemeral:
    type: emptyDir
  persistent:
    type: persistentVolumeClaim
    storageClass: longhorn
    accessMode: ReadWriteOnce
    size: 5Gi
    globalMounts:
      - path: /pdata
        subPath: data
      - path: /media
        subPath: media
