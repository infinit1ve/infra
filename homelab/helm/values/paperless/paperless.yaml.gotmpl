# yaml-language-server: $schema=https://raw.githubusercontent.com/bjw-s-labs/helm-charts/main/charts/library/common/values.schema.json

controllers:
  main:
    strategy: Recreate
    containers:
      main:
        image:
          repository: ghcr.io/paperless-ngx/paperless-ngx
          tag: 3.5.1
          digest: sha256:8508853b8a0f8394074260957d0be186c8c64f346973b24a7583de4580f306b9
        dependsOn:
          - "tika"
          - "gotenberg"
          - "redis"
        env:
          PAPERLESS_REDIS: redis://localhost:6379
          PAPERLESS_DBENGINE: postgresql
          PAPERLESS_DBHOST:
            valueFrom:
              secretKeyRef:
                name: paperless-db-app
                key: host
          PAPERLESS_DBPORT:
            valueFrom:
              secretKeyRef:
                name: paperless-db-app
                key: port
          PAPERLESS_DBNAME:
            valueFrom:
              secretKeyRef:
                name: paperless-db-app
                key: dbname
          PAPERLESS_DBUSER:
            valueFrom:
              secretKeyRef:
                name: paperless-db-app
                key: username
          PAPERLESS_DBPASS:
            valueFrom:
              secretKeyRef:
                name: paperless-db-app
                key: password
          PAPERLESS_SECRET_KEY: {{ .Values.services.k3s.paperless | quote }}
          PAPERLESS_TIME_ZONE: Europe/Berlin
          PAPERLESS_OCR_LANGUAGES: eng deu ukr
          PAPERLESS_URL: "https://paperless.{{ .Values.domain }}"
          PAPERLESS_TIKA_ENABLED: 1
          PAPERLESS_TIKA_GOTENBERG_ENDPOINT: http://localhost:3000
          PAPERLESS_TIKA_ENDPOINT: http://localhost:9998
          PAPERLESS_DATA_DIR: /pdata
          PAPERLESS_MEDIA_ROOT: /media
        probes:
          liveness:
            enabled: true
            custom: true
            spec:
              httpGet:
                path: /accounts/login/
                port: 8000
                httpHeaders:
                  - name: Host
                    value: localhost
              initialDelaySeconds: 30
              periodSeconds: 15
          readiness:
            enabled: true
            custom: true
            spec:
              httpGet:
                path: /accounts/login/
                port: 8000
                httpHeaders:
                  - name: Host
                    value: localhost
              initialDelaySeconds: 15
              periodSeconds: 10
          startup:
            enabled: true
            custom: true
            spec:
              httpGet:
                path: /accounts/login/
                port: 8000
                httpHeaders:
                  - name: Host
                    value: localhost
              failureThreshold: 30
              periodSeconds: 10
      redis:
        image:
          repository: docker.io/valkey/valkey
          tag: 9-alpine
          digest: sha256:c8e2d17498838af5d91e12eb7c11220b3434a7b7131a333e3af52ad5e0b80882
      gotenberg:
        image:
          repository: docker.io/gotenberg/gotenberg
          tag: 9.10
          digest: sha256:daede2c52129da3b9eef655fdad5de0c0a978f1119bb1c459ee88388982b1b70
        command:
          - "gotenberg"
        args:
          - "--chromium-disable-javascript=true"
          - "--chromium-allow-list=^file:///tmp/.*"
      tika:
        image:
          repository: docker.io/apache/tika
          tag: 3.3.3.1
          digest: sha256:3049611264bb18cf66e6629f59818cad75ea5d46f770c504ae46537949838c67

service:
  main:
    controller: main
    ports:
      http:
        port: 80
        targetPort: 8000

ingress:
  main:
    hosts:
      - host: paperless.{{ .Values.domain }}
        paths:
          - path: /
            pathType: Prefix
            service:
              identifier: main
              port: http

persistence:
  ephemeral:
    type: emptyDir
  persistent:
    type: persistentVolumeClaim
    storageClass: longhorn
    accessMode: ReadWriteOnce
    size: 5Gi
    globalMounts:
      - path: /pdata
        subPath: data
      - path: /media
        subPath: media
