resources:
- apiVersion: v1
  kind: Secret
  metadata:
    name: cloudflare-api-token-secret
    namespace: cert-manager
  type: Opaque
  stringData:
    api-token: {{ .Values.services.k3s.cloudflare | quote }}
- apiVersion: cert-manager.io/v1
  kind: ClusterIssuer
  metadata:
    name: cloudflare-clusterissuer
  spec:
    acme:
      email: "contact@{{ .Values.services.email.domain }}"
      server: https://acme-v02.api.letsencrypt.org/directory
      privateKeySecretRef:
        name: cloudflare-clusterissuer-account-key
      solvers:
        - dns01:
            cloudflare:
              apiTokenSecretRef:
                name: cloudflare-api-token-secret
                key: api-token
