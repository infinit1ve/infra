{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "pinDigests": true,
  "abandonmentThreshold": "1 year",
  "assignees": [ "contact@infinitive.cc" ],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "Turn off major updates for sidecars and postgres",
      "matchPackageNames": [ "/(?:^|\\/)(?:valkey|tika|gotenberg|postgresql|mysql|redis)$/" ],
      "matchUpdateTypes": ["major"],
      "matchIsBreaking": false,
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update Docker images in bjw-s Helm values",
      "managerFilePatterns": [
        "/\\.gotmpl$/",
        "/\\.ya?ml$/"
      ],
      "matchStringsStrategy": "any",
      "matchStrings": [
        "(?m)^[ \\t]*image:[ \\t]*\\r?\\n[ \\t]+repository:[ \\t]*[\"']?(?<depName>[^\"' \\t\\r\\n]+)[\"']?[ \\t]*\\r?\\n[ \\t]+tag:[ \\t]*[\"']?(?<currentValue>[^\"' \\t\\r\\n]+)[\"']?(?:[ \\t]*\\r?\\n[ \\t]+digest:[ \\t]*[\"']?(?<currentDigest>sha256:[a-fA-F0-9]{64})[\"']?)?"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update cnpg images",
      "managerFilePatterns": [
        "/-db\\.ya?ml$/"
      ],
      "matchStringsStrategy": "any",
      "matchStrings": [
        "\\s+imageName:\\s(?<depName>[^\"' \\t\\r\\n:]+):(?<currentValue>[^\"' \\t\\r\\n:@]+)@(?<currentDigest>sha256:[a-fA-F0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ]
}
